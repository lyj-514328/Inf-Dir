{
  "manifestVersion": 1,
  "id": "inf-dir.web-view",
  "name": "网页查看器",
  "version": "0.1.0",
  "entrypoint": "web-view.exe",
  "capabilities": {
    "quickView": {
      "extensions": [
        ".svg", ".svgz", ".html", ".htm", ".xhtml",
        ".mht", ".mhtml", ".shtml", ".shtm",
        ".xml", ".xsl", ".xslt",
        ".vsd", ".vsdm", ".vsdx", ".vss", ".vssm", ".vssx",
        ".vst", ".vstm", ".vstx", ".vdx", ".vdw", ".vsx", ".vtx"
      ],
      "mimeTypes": [
        "image/svg+xml", "text/html", "application/xhtml+xml",
        "multipart/related", "application/xml", "text/xml",
        "application/vnd.visio"
      ]
    }
  }
}
