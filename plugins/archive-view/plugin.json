{
  "manifestVersion": 1,
  "id": "inf-dir.archive-view",
  "name": "压缩包查看器",
  "version": "0.1.0",
  "entrypoint": "archive-view.exe",
  "capabilities": {
    "quickView": {
      "extensions": [
        ".zip", ".7z", ".rar", ".tar", ".gz", ".xz", ".bz2",
        ".iso", ".cab", ".arj", ".lzh",
        ".cpio", ".xar", ".rpm", ".deb", ".wim", ".lzma", ".lz4",
        ".z", ".lha", ".lzip", ".tgz", ".tbz", ".tbz2", ".txz",
        ".tlz", ".tar.gz", ".tar.bz2", ".tar.xz", ".ar", ".zipx",
        ".pk3", ".pk4", ".pkz", ".jar", ".war", ".apk", ".dmg", ".hfs",
        ".cbr", ".deskthemepack", ".tar.lzma", ".taz"
      ],
      "mimeTypes": [
        "application/zip", "application/x-7z-compressed",
        "application/vnd.rar", "application/x-tar", "application/gzip"
      ]
    }
  }
}
