{
  "manifestVersion": 1,
  "id": "inf-dir.code-view",
  "name": "代码查看器",
  "version": "0.1.0",
  "entrypoint": "code-view.exe",
  "capabilities": {
    "quickView": {
      "extensions": [
        ".a2l", ".ads", ".ahk", ".as", ".asm", ".asp", ".aspx",
        ".au3", ".bas", ".bash", ".bat", ".bpk", ".bpr", ".c",
        ".cbl", ".cc", ".cfg", ".cfm", ".cgi", ".cjs", ".clp",
        ".cmake", ".cmd", ".conf", ".config", ".cpp", ".cs", ".csh",
        ".css", ".csv", ".cxx", ".dart", ".dfm", ".diff", ".diz",
        ".dpk", ".dpr", ".eba", ".erl", ".ex", ".f", ".fish",
        ".fs", ".fsx", ".go", ".gql", ".gradle", ".graphql", ".groovy",
        ".h", ".haml", ".hh", ".hlsl", ".hpp", ".hs", ".htm",
        ".html", ".hxx", ".inc", ".inf", ".ini", ".iss", ".iwb",
        ".java", ".js", ".json", ".jsonc", ".jsx", ".kix", ".kt",
        ".kts", ".less", ".lhs", ".log", ".lua", ".mjs", ".ml",
        ".nfo", ".nsh", ".nsi", ".ob2", ".pas", ".php", ".pl",
        ".pm", ".pod", ".prg", ".properties", ".proto", ".ps1", ".py",
        ".r", ".rb", ".rc", ".rs", ".sas", ".sass", ".scala",
        ".scm", ".scss", ".sh", ".shtm", ".shtml", ".sql", ".ss",
        ".st", ".stm", ".sty", ".svelte", ".swift", ".tcl", ".tex",
        ".toml", ".ts", ".tsv", ".tsx", ".v", ".vb", ".vhd",
        ".txt", ".vue",
        ".xml", ".xsd", ".xsl", ".xslt", ".yaml", ".yml", ".zsh"
      ],
      "fileNames": [
        ".editorconfig", ".env", ".gitattributes", ".gitignore",
        "cmakelists.txt", "dockerfile", "makefile"
      ],
      "mimeTypes": [
        "application/javascript", "application/json", "application/xml",
        "text/css", "text/html", "text/javascript"
      ]
    }
  }
}
