{
  "manifestVersion": 1,
  "id": "inf-dir.text-view",
  "name": "文本查看器",
  "version": "0.1.0",
  "entrypoint": "text-view.exe",
  "capabilities": {
    "quickView": {
      "extensions": [
        ".txt", ".md", ".log", ".csv", ".json", ".xml", ".yaml", ".yml",
        ".ini", ".conf", ".cfg", ".bat", ".cmd", ".ps1", ".sh", ".dart",
        ".py", ".js", ".ts", ".rs", ".go", ".c", ".cpp", ".h", ".hpp",
        ".java", ".cs", ".html", ".css", ".sql", ".toml", ".gradle",
        ".properties"
      ],
      "fileNames": [".env", ".gitignore", "dockerfile"],
      "mimeTypes": ["text/*", "application/json", "application/xml"]
    }
  }
}
